# Server-side only. Never prefix these with NEXT_PUBLIC_: they must not reach the browser.
LEDQUILL_API_URL=http://localhost:8000
LEDQUILL_API_KEY=

# Public number, never a secret: it is bundled into the browser. Set it only where the host caps
# the request body (hosted demo). Unset or invalid keeps the default hint of 25 MB per file.
# NEXT_PUBLIC_MAX_UPLOAD_MB=4
